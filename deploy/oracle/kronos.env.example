# Copiar a ~/kronos.env sustituyendo /home/ubuntu por el home real.
KRONOS_PYTHON=/home/ubuntu/kronos-project/tools/kronos-env/bin/python
KRONOS_DATA_DIR=/home/ubuntu/kronos-data
HF_HOME=/home/ubuntu/kronos-data/huggingface
KRONOS_TORCH_THREADS=2
PYTHONUTF8=1
PYTHONUNBUFFERED=1
# Activar solo despues del smoke ARM, importar registro y validar backup.
KRONOS_AUTO_FORECAST=0
